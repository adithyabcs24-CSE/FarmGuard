# ==============================================================================
# FarmGuard AI — Environment Configuration (.env)
# ==============================================================================

# --- Application Settings ---
APP_NAME="FarmGuard AI"
APP_ENV="development"
HOST="127.0.0.1"
PORT="8000"
DEBUG="True"

# --- Security & JWT Authentication ---
# In production, replace with a strong random key (e.g. `openssl rand -hex 32`)
SECRET_KEY="farmguard-ai-secure-secret-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"  # 7 days (60 * 24 * 7)

# --- Database Storage ---
# Default SQLite database path (can be changed to PostgreSQL for cloud deployment)
DATABASE_URL="sqlite:///./farmguard.db"

# --- AI & External Integrations ---
# Google Gemini API key for advanced vision & multi-modal diagnosis (Optional)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=""

# Weather API key for real-time localized disease pressure alerts (Optional)
WEATHER_API_KEY=""

# --- Kisan Voice AI & Scanner Defaults ---
# Default language for speech and advisory readout (English, Kannada, or Hindi)
DEFAULT_ADVISORY_LANGUAGE="English"
